@model List<Employee>

    <h4>Count: @ViewBag.Emm </h4>

<table class="table table-bordered">
    <thead>

        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Dept</th>
            <th>Age</th>            
        </tr>

    </thead>

    @foreach (var employee in Model)
    {
        <tr>            
            <td>
                @employee.EmployeeId
            </td>
            <td>
                @employee.Name
            </td>
            <td>
                @employee.DepartmentId
            </td>
            <td>
                @employee.Age
            </td>            
        </tr>
    }

</table>