@model List<Employee>

    <h2>Employee List</h2>

    <table class="table table-bordered">
        <thead>

            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Dept</th>
                <th>Salary</th>
                <th>Joining Year</th>
            </tr>
        
        </thead>

        @foreach(var employee in Model)
    {
        <tr>
            @* <td></td> *@
        <td> 
            @employee.EmployeeId;
        </td>
        <td>
            @employee.EmployeeName;
        </td>
        <td>
            @employee.Department;
        </td>
        <td>
            @employee.Salary;
        </td>
        <td>
            @employee.JoiningYear;
        </td>
        </tr>

    }

    </table>