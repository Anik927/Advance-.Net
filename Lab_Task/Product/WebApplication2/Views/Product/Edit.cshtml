@model Product
<form method="post">
    <div class="mb-3">
        <label class="form-label" asp-for="Id"></label>
        <input type="text" class="form-control" readonly="readonly" asp-for="Id" />
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Name"></label>
        <input type="text" class="form-control" asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label class="form-label" asp-for="Price"></label>
        <input type="text" class="form-control" asp-for="Price" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label class="form-label" asp-for="Quantity"></label>
        <input type="text" class="form-control" asp-for="Quantity" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-info">Save</button>
    </div>

</form>